{
  "name": "markspread",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Markspread — lightweight markdown reviewer for the AI era",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "vite:dev": "vite",
    "vite:build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "a11y:check-tabindex": "node scripts/check-tabindex.mjs",
    "a11y:check-contrast": "node scripts/check-contrast.mjs",
    "i18n:check-hardcoded": "node scripts/check-hardcoded-strings.mjs",
    "i18n:check-unused": "node scripts/check-unused-keys.mjs",
    "i18n:progress": "node scripts/i18n-progress.mjs",
    "gen:licenses": "node scripts/generate-licenses.mjs",
    "gen:notice": "node scripts/generate-notice.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/pretendard": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@markspread/parser-sdk": "workspace:*",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "dompurify": "^3.4.15",
    "i18next": "^23.16.8",
    "katex": "^0.16.47",
    "mermaid": "^11.17.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^15.7.4",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.10.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"],
    "overrides": {
      "ws@>=8.0.0 <8.20.1": ">=8.20.1"
    }
  }
}
