{
  "name": "markspread",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Markspread — lightweight markdown reviewer for the AI era",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "vite:dev": "vite",
    "vite:build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "a11y:check-tabindex": "node scripts/check-tabindex.mjs",
    "a11y:check-contrast": "node scripts/check-contrast.mjs",
    "i18n:check-hardcoded": "node scripts/check-hardcoded-strings.mjs",
    "i18n:check-unused": "node scripts/check-unused-keys.mjs",
    "i18n:progress": "node scripts/i18n-progress.mjs",
    "gen:licenses": "node scripts/generate-licenses.mjs",
    "gen:notice": "node scripts/generate-notice.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.34.0",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/jetbrains-mono": "^5.1.1",
    "@fontsource/pretendard": "^5.2.5",
    "@lezer/highlight": "^1.2.0",
    "@markspread/parser-sdk": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.3",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "dompurify": "^3.4.7",
    "i18next": "^23.16.0",
    "katex": "^0.16.46",
    "mermaid": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.0.2",
    "unified": "^11.0.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^4.8.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ],
    "overrides": {
      "ws@>=8.0.0 <8.20.1": ">=8.20.1"
    }
  }
}
